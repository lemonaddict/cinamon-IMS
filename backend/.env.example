APP_ENV=development
ADDR=:8080
DATABASE_URL=postgres://ims:change-me@localhost:5432/ims?sslmode=disable
# Self-registration is OFF by default. Only set true as a temporary emergency hatch.
ALLOW_REGISTRATION=false
# Optional: create the first admin on empty DB (remove after first successful login).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin
# Comma-separated frontend origins for CORS (production must list your real domain).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
